{
  "ConfigVersion": "0.5",
  "_comment": "MM30_Prep configuration. Keys starting with an underscore are comments. Precedence: defaults < this file < command line. See the script header for details.",
  "General": {
    "_comment": "Work folder for the state backup (used by Restore) and the logs.",
    "WorkDir": "C:\\MM30Prep"
  },
  "Display": {
    "_comment": "BrightnessPercent = Windows brightness in %. Measure cd/m2 with the MM30 Brightness Profiler: it must stay >= 250. BrightnessMap = { \"Model substring\": percent } overrides it per model (matched against the WMI model). BrightnessMapPath = same map in a separate JSON file.",
    "BrightnessPercent": 83,
    "BrightnessMapPath": null,
    "BrightnessMap": {},
    "SkipBrightness": false,
    "Volume": 50,
    "Theme": "Keep",
    "ThemeAccentOnTaskbar": false
  },
  "Power": {
    "_comment": "PowerMode applies to battery (DC) and plugged-in (AC) unless PowerModeDC / PowerModeAC are set. Values: Efficiency, Balanced, BetterPerformance, Performance. BatterySaverThreshold: 0 = never, maximum 20 (Run Rules).",
    "PowerMode": "Balanced",
    "PowerModeDC": null,
    "PowerModeAC": null,
    "BatterySaverThreshold": 20,
    "MinProcessorStateDC": 5,
    "MaxProcessorStateDC": 100,
    "CpuEppDC": null,
    "CpuBoostModeDC": null
  },
  "Shell": {
    "_comment": "Taskbar buttons (Widgets, Task view), Resume and theme refresh. Windows protects the Widgets values: the Settings page is used as a fallback, and Explorer is restarted once to apply everything.",
    "HideWidgets": true,
    "HideTaskView": true,
    "DisableResume": true,
    "RestartExplorer": true,
    "UseSettingsUiFallback": true,
    "RemoveWidgetsApp": false
  },
  "Language": {
    "_comment": "Installs and activates LanguageTag (needs Internet). KeyboardKlid 0000040C = French AZERTY (legacy). ExtraLanguages are kept after the default one. HomeLocationGeoId: 84 = France, 244 = United States, null = untouched.",
    "ManageLanguage": true,
    "LanguageTag": "en-US",
    "KeyboardKlid": "0000040C",
    "ExtraLanguages": [],
    "SetSystemLocale": true,
    "HomeLocationGeoId": null,
    "CopyLanguageToSystem": true
  },
  "Logon": {
    "_comment": "AcceptPasswordlessSingleUser: a single enabled local account without password counts as auto-logon.",
    "AcceptPasswordlessSingleUser": true
  },
  "Checks": {
    "_comment": "Minimum Windows build, RAM (GB) and free space on C: (GB) used by the prerequisite checks.",
    "MinBuild": 22621,
    "MinRamGB": 16,
    "MinFreeDiskGB": 30
  },
  "Optimizations": {
    "_comment": "Startup entries, services, scheduled tasks (TaskPath|NamePattern), Windows Update services and Defender exclusion paths (environment variables allowed) handled by PreRun.",
    "KeepVisualEffects": false,
    "KeepSysMain": false,
    "NoSystemFallback": false,
    "StartupPatterns": [
      "OneDrive*",
      "*Teams*",
      "MicrosoftEdgeAutoLaunch*",
      "Skype*",
      "Spotify*",
      "Discord*",
      "Steam*",
      "Dropbox*",
      "Zoom*",
      "Webex*"
    ],
    "NoiseServices": [
      "DiagTrack",
      "dmwappushservice",
      "WerSvc",
      "MapsBroker",
      "RetailDemo",
      "XblAuthManager",
      "XblGameSave",
      "XboxNetApiSvc",
      "XboxGipSvc",
      "lfsvc",
      "wisvc",
      "edgeupdate",
      "edgeupdatem"
    ],
    "NoiseTasks": [
      "\\Microsoft\\Windows\\Defrag\\|ScheduledDefrag",
      "\\Microsoft\\Windows\\Application Experience\\|*",
      "\\Microsoft\\Windows\\Customer Experience Improvement Program\\|*",
      "\\Microsoft\\Windows\\DiskDiagnostic\\|*",
      "\\Microsoft\\Windows\\Windows Error Reporting\\|*",
      "\\Microsoft\\Windows\\UpdateOrchestrator\\|*",
      "\\Microsoft\\Windows\\WindowsUpdate\\|*",
      "\\Microsoft\\Windows\\WaaSMedic\\|*",
      "\\Microsoft\\Windows\\InstallService\\|*",
      "\\Microsoft\\Windows\\Maintenance\\|*",
      "\\Microsoft\\Windows\\Power Efficiency Diagnostics\\|*",
      "\\Microsoft\\Windows\\Diagnosis\\|*",
      "\\Microsoft\\Windows\\Chkdsk\\|*",
      "\\Microsoft\\Windows\\Registry\\|*",
      "\\Microsoft\\Windows\\Feedback\\Siuf\\|*",
      "\\Microsoft\\Windows\\SystemRestore\\|*",
      "\\Microsoft\\Windows\\Windows Defender\\|*",
      "\\|OneDrive*",
      "\\|MicrosoftEdgeUpdate*"
    ],
    "UpdateServices": [
      "wuauserv",
      "UsoSvc",
      "DoSvc",
      "BITS"
    ],
    "DefenderExclusionPaths": [
      "C:\\Program Files (x86)\\BAPCo",
      "%USERPROFILE%\\Desktop\\Results",
      "%PUBLIC%\\Desktop\\Results"
    ]
  },
  "Advanced": {
    "_comment": "Options that move away from the calibration setup: document them with the FDR. Aggressive = DisableNetwork + DisableBluetooth + DefenderRealtimeOff.",
    "DisableNetwork": false,
    "DisableBluetooth": false,
    "DefenderRealtimeOff": false,
    "DisableMemoryIntegrity": false,
    "StopOemServices": false,
    "OemServicePatterns": [
      "Asus*",
      "ASUS*",
      "Armoury*"
    ],
    "Aggressive": false
  }
}